# ---------- API (apps/api/.env) ----------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://acee:acee_dev_password@localhost:5433/acee
# Origins allowed to make cookie-authenticated writes (CSRF check). Production: https://www.your-domain
WEB_ORIGINS=http://localhost:3000
# Used to build staff invitation links.
PUBLIC_WEB_URL=http://localhost:3000
# Which proxies may set X-Forwarded-For: loopback (Next.js on same host) | false | comma-separated IP/CIDR list
TRUST_PROXY=loopback
STORAGE_DRIVER=local
# Private upload directory. Must NOT be inside any web-served folder. Back it up with the database.
STORAGE_LOCAL_DIR=./storage
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
WEB_SESSION_DAYS=7
# Email (password reset codes, notifications). Dev: Mailpit from docker compose, inbox at http://localhost:8025.
# Production: your provider, e.g. smtps://user:pass@smtp.example.com:465. Without it, password reset is unavailable.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=ACEE Student Portal <no-reply@aceereviewconsultants.com>
# Sites allowed to post the public inquiry form (the main website's contact form).
INQUIRY_ORIGINS=https://www.aceereviewconsultants.com,https://aceereviewconsultants.com
# Optional channels. Leave empty: the app then reports them as "not configured" and sends nothing.
SMS_PROVIDER_KEY=
WHATSAPP_TOKEN=
EXPO_PUSH_ENABLED=false

# ---------- Web (apps/web/.env.local) ----------
API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Android (EAS profile env or apps/mobile/.env) ----------
# Emulator -> host machine is 10.0.2.2. Real device on Wi-Fi: http://<your-PC-LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# ---------- One-time super admin provisioning ----------
# SUPERADMIN_PASSWORD=<set only in the shell when running provision:superadmin>
