generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  COUNSELOR
  TRAINER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum Language {
  en
  te
  hi
}

// ---------- Identity ----------

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  mobile            String     @unique
  passwordHash      String
  fullName          String
  role              Role       @default(STUDENT)
  status            UserStatus @default(ACTIVE)
  district          String?
  preferredLanguage Language   @default(en)
  emailVerifiedAt   DateTime?
  mobileVerifiedAt  DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions            Session[]
  studentProfile      StudentProfile?
  counselorProfile    CounselorProfile?
  trainerProfile      TrainerProfile?
  consents            Consent[]
  assessments         EligibilityAssessment[]
  enrollments         Enrollment[]
  attendance          Attendance[]               @relation("AttendanceStudent")
  attendanceMarked    Attendance[]               @relation("AttendanceMarker")
  trainerBatches      Batch[]
  availability        CounselingAvailability[]
  studentAppointments Appointment[]              @relation("StudentAppointments")
  counselorAppts      Appointment[]              @relation("CounselorAppointments")
  notesWritten        CounselorNote[]            @relation("NoteAuthor")
  notesAbout          CounselorNote[]            @relation("NoteStudent")
  applications        Application[]              @relation("ApplicationStudent")
  assignedApps        Application[]              @relation("ApplicationCounselor")
  stageChanges        ApplicationStageHistory[]
  appNotes            ApplicationNote[]
  documents           Document[]
  docReviews          DocumentReview[]
  notifications       Notification[]
  announcements       Announcement[]
  inquiriesAssigned   Inquiry[]
  auditLogs           AuditLog[]
  invitationsSent     Invitation[]
  dataRequests        DataRequest[]
  ruleVersions        SchemeRuleVersion[]
  materials           StudyMaterial[]
  passwordResets      PasswordReset[]

  @@index([role, status])
  @@index([createdAt])
}

enum SessionKind {
  WEB
  MOBILE
}

/// Opaque tokens; only SHA-256 hashes are stored. Mobile refresh tokens rotate per use within a family.
model Session {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             SessionKind
  tokenHash        String      @unique
  expiresAt        DateTime
  refreshTokenHash String?     @unique
  refreshExpiresAt DateTime?
  familyId         String
  revokedAt        DateTime?
  replacedAt       DateTime?
  userAgent        String?
  ip               String?
  createdAt        DateTime    @default(now())

  @@index([userId])
  @@index([familyId])
}

/// One-time 6-digit code for "forgot password". Only a hash is stored; 10-minute expiry, 5 attempts.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  channel   String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  fullName    String
  role        Role
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualification   String?
  fieldOfStudy    String?
  graduationYear  Int?
  intendedCountry String?
  intendedLevel   String?
  intendedIntake  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CounselorProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String   @default("")
  languages Language[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String   @default("")
  specializations String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ConsentPurpose {
  TERMS
  PRIVACY
  COMM_EMAIL
  COMM_SMS
  COMM_WHATSAPP
  COMM_PUSH
}

/// Append-only: the latest row per (user, purpose) is the current state.
model Consent {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   ConsentPurpose
  granted   Boolean
  version   String
  ip        String?
  createdAt DateTime       @default(now())

  @@index([userId, purpose, createdAt])
}

// ---------- Scholarships ----------

enum SchemeCategory {
  SC
  ST
}

model ScholarshipScheme {
  id          String              @id @default(cuid())
  code        String              @unique
  name        Json
  description Json
  officialUrl String
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  versions    SchemeRuleVersion[]
  assessments EligibilityAssessment[]
}

/// Immutable once created. Changing rules = new version; activating one deactivates the others for that category.
model SchemeRuleVersion {
  id            String         @id @default(cuid())
  schemeId      String
  scheme        ScholarshipScheme @relation(fields: [schemeId], references: [id])
  category      SchemeCategory
  version       Int
  rules         Json
  sourceUrl     String
  goReference   String
  verifiedAt    DateTime
  effectiveFrom DateTime
  notes         String         @default("")
  active        Boolean        @default(false)
  createdById   String?
  createdBy     User?          @relation(fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  assessments   EligibilityAssessment[]

  @@unique([schemeId, category, version])
  @@index([schemeId, category, active])
}

enum EligibilityOutcome {
  ELIGIBLE
  REVIEW
  NOT_MET
}

model EligibilityAssessment {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemeId      String
  scheme        ScholarshipScheme  @relation(fields: [schemeId], references: [id])
  ruleVersionId String?
  ruleVersion   SchemeRuleVersion? @relation(fields: [ruleVersionId], references: [id])
  inputs        Json
  outcome       EligibilityOutcome
  results       Json
  createdAt     DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([outcome, createdAt])
}

// ---------- Coaching ----------

model Course {
  id            String   @id @default(cuid())
  code          String   @unique
  name          Json
  description   Json
  durationWeeks Int
  isFree        Boolean  @default(false)
  feeAmount     Int?
  feeNote       Json
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  batches       Batch[]
  materials     StudyMaterial[]
}

enum DeliveryMode {
  ONLINE
  OFFLINE
  HYBRID
}

model Batch {
  id          String       @id @default(cuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id])
  name        String
  mode        DeliveryMode
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  days        String[]
  startTime   String
  endTime     String
  capacity    Int
  trainerId   String?
  trainer     User?        @relation(fields: [trainerId], references: [id])
  location    String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
  attendance  Attendance[]
  materials   StudyMaterial[]
  announcements Announcement[]

  @@index([courseId, active])
  @@index([trainerId])
}

enum EnrollmentStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
  COMPLETED
}

model Enrollment {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId       String
  batch         Batch            @relation(fields: [batchId], references: [id])
  preferredMode String
  status        EnrollmentStatus @default(CONFIRMED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, batchId])
  @@index([batchId, status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id         String           @id @default(cuid())
  batchId    String
  batch      Batch            @relation(fields: [batchId], references: [id])
  userId     String
  user       User             @relation("AttendanceStudent", fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  markedById String
  markedBy   User             @relation("AttendanceMarker", fields: [markedById], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([batchId, userId, date])
  @@index([userId])
}

model StudyMaterial {
  id          String   @id @default(cuid())
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id])
  batchId     String?
  batch       Batch?   @relation(fields: [batchId], references: [id])
  title       String
  url         String
  description String   @default("")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([batchId])
}

// ---------- Counseling ----------

model CounselingAvailability {
  id          String   @id @default(cuid())
  counselorId String
  counselor   User     @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startTime   String
  endTime     String
  slotMinutes Int      @default(30)
  mode        String   @default("BOTH")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([counselorId, dayOfWeek])
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id               String            @id @default(cuid())
  studentId        String
  student          User              @relation("StudentAppointments", fields: [studentId], references: [id], onDelete: Cascade)
  counselorId      String
  counselor        User              @relation("CounselorAppointments", fields: [counselorId], references: [id])
  startsAt         DateTime
  endsAt           DateTime
  type             String
  mode             String
  status           AppointmentStatus @default(BOOKED)
  questions        String            @default("")
  meetingLink      String?
  followUpStatus   String            @default("NONE")
  /// "<counselorId>|<iso start>" while BOOKED, null otherwise: the unique index makes double booking impossible.
  counselorSlotKey String?           @unique
  studentSlotKey   String?           @unique
  rescheduledFromId String?
  cancelledAt      DateTime?
  reminderSentAt   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  notes            CounselorNote[]

  @@index([counselorId, startsAt])
  @@index([studentId, startsAt])
}

/// Private to staff. Never returned on student endpoints.
model CounselorNote {
  id             String       @id @default(cuid())
  studentId      String
  student        User         @relation("NoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation("NoteAuthor", fields: [authorId], references: [id])
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  body           String
  followUpStatus String       @default("NONE")
  followUpDate   DateTime?    @db.Date
  createdAt      DateTime     @default(now())

  @@index([studentId, createdAt])
  @@index([authorId, followUpStatus])
}

// ---------- Application assistance (internal ACEE workflow, never a government status) ----------

model ApplicationStage {
  id        String   @id @default(cuid())
  code      String   @unique
  name      Json
  order     Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  applications Application[]
  historyFrom  ApplicationStageHistory[] @relation("FromStage")
  historyTo    ApplicationStageHistory[] @relation("ToStage")
}

model Application {
  id                       String            @id @default(cuid())
  studentId                String
  student                  User              @relation("ApplicationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  stageId                  String
  stage                    ApplicationStage  @relation(fields: [stageId], references: [id])
  assignedCounselorId      String?
  assignedCounselor        User?             @relation("ApplicationCounselor", fields: [assignedCounselorId], references: [id])
  intendedCountry          String?
  intake                   String?
  pendingActions           String            @default("")
  /// What the student told us about the official application. Labelled as self-reported everywhere.
  studentReportedGovtStatus String           @default("")
  closedAt                 DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  history                  ApplicationStageHistory[]
  notes                    ApplicationNote[]

  @@index([stageId])
  @@index([assignedCounselorId])
  @@index([studentId])
}

model ApplicationStageHistory {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStageId   String?
  fromStage     ApplicationStage? @relation("FromStage", fields: [fromStageId], references: [id])
  toStageId     String
  toStage       ApplicationStage  @relation("ToStage", fields: [toStageId], references: [id])
  changedById   String
  changedBy     User              @relation(fields: [changedById], references: [id])
  note          String            @default("")
  createdAt     DateTime          @default(now())

  @@index([applicationId, createdAt])
}

model ApplicationNote {
  id               String      @id @default(cuid())
  applicationId    String
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId         String
  author           User        @relation(fields: [authorId], references: [id])
  body             String
  visibleToStudent Boolean     @default(false)
  createdAt        DateTime    @default(now())

  @@index([applicationId, createdAt])
}

// ---------- Documents ----------

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
  DELETED
}

model Document {
  id          String         @id @default(cuid())
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category    String
  fileName    String
  mimeType    String
  sizeBytes   Int
  sha256      String
  storageKey  String         @unique
  status      DocumentStatus @default(PENDING)
  version     Int            @default(1)
  replacesId  String?
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  reviews     DocumentReview[]

  @@index([ownerId, category])
  @@index([status, createdAt])
}

model DocumentReview {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  decision   String
  reason     String   @default("")
  createdAt  DateTime @default(now())

  @@index([documentId])
}

// ---------- Communication ----------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  /// i18n keys in the `notifications` namespace, rendered in the reader's language.
  titleKey  String
  bodyKey   String
  params    Json      @default("{}")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

enum Audience {
  PUBLIC
  STUDENTS
  STAFF
  BATCH
}

model Announcement {
  id          String    @id @default(cuid())
  title       Json
  body        Json
  audience    Audience
  batchId     String?
  batch       Batch?    @relation(fields: [batchId], references: [id])
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([audience, publishedAt])
  @@index([batchId])
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model Inquiry {
  id           String        @id @default(cuid())
  name         String
  mobile       String
  email        String?
  interest     String
  message      String        @default("")
  /// "portal" or "main-site" (the www.aceereviewconsultants.com contact form).
  source       String        @default("portal")
  status       InquiryStatus @default(NEW)
  consentAt    DateTime
  assignedToId String?
  assignedTo   User?         @relation(fields: [assignedToId], references: [id])
  ip           String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
}

/// Admin-editable content blocks. `content` holds per-language strings ({en,te,hi}) where text is shown.
model CmsContent {
  id            String    @id @default(cuid())
  key           String    @unique
  content       Json
  /// Business facts (contact details etc.) must be confirmed by a SUPER_ADMIN before production.
  confirmedAt   DateTime?
  confirmedById String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ---------- Governance ----------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

enum DataRequestType {
  DELETE_ACCOUNT
  EXPORT
}

enum DataRequestStatus {
  OPEN
  COMPLETED
  REJECTED
}

model DataRequest {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        DataRequestType
  status      DataRequestStatus @default(OPEN)
  reason      String            @default("")
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())

  @@index([status])
}
