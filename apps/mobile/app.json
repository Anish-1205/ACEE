{
  "expo": {
    "name": "ACEE Global Education",
    "slug": "acee-global-education",
    "scheme": "aceeglobal",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.aceereview.globaleducation",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#102E5C" },
      "permissions": ["CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-status-bar",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 160, "backgroundColor": "#102E5C" }],
      ["expo-image-picker", { "cameraPermission": "Allow ACEE Global Education to take photos of your documents for upload.", "photosPermission": false }]
    ],
    "experiments": { "typedRoutes": false },
    "extra": { "apiUrl": "http://10.0.2.2:4000" }
  }
}
